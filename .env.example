# Telegram API Credentials (Get from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot Token (Get from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Userbot Session String (Generated via Telethon StringSession)
SESSION_STRING=1B23...your_userbot_session...

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/autoposter_userbot_db
DB_NAME=autoposter_userbot_db

# Admin User Telegram ID (for error alerts, link selection, and status reports)
ADMIN_ID=123456789

# Web Server Configuration (for Koyeb, Render, Heroku)
PORT=8080
# IMPORTANT: Set APP_URL to your public Koyeb app URL to prevent service sleep
APP_URL=https://your-service-name.koyeb.app

# Timing Configurations (in seconds)
# Human-like randomized posting interval range (e.g. 50 mins to 70 mins)
POST_INTERVAL_MIN=3000
POST_INTERVAL_MAX=4200
POST_INTERVAL_SECONDS=3600
POST_DELAY_SECONDS=3

# Auto-ping interval (600s = 10 minutes to keep Koyeb awake)
PING_INTERVAL_SECONDS=600

# Group slowmode safety buffer (in seconds)
COOLDOWN_BUFFER_SECONDS=120
